# App
NODE_ENV=development
PORT=5000

# Database (MongoDB)
MONGO_URI=mongodb://localhost:27017/careerAI

# Auth (minimum 32 characters, random)
JWT_SECRET=<generate-a-long-random-string>

# AI (Groq)
GROQ_API_KEY=<your-groq-api-key>

# Frontend URL for CORS (no trailing slash)
CLIENT_URL=http://localhost:5173

# Optional: true karne se detailed AI logs aate hain (production mein false rakho)
AI_DEBUG=false